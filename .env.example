# Образец настроек для send.php.
# Скопируйте в .env (рядом с send.php) или, надёжнее, на уровень выше корня сайта
# и впишите настоящие значения. Файл .env не попадает в git — см. .gitignore.

# токен бота от @BotFather
TELEGRAM_BOT_TOKEN=0000000000:REPLACE_WITH_BOT_TOKEN
# id группы «Заявки»
TELEGRAM_CHAT_ID=-1000000000000
